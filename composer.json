{
    "name": "jazz-max/yandex-ai-laravel",
    "description": "Laravel SDK for Yandex AI Studio — Responses API, Vision OCR, Embeddings",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "yandex", "ai", "gpt", "ocr", "vision", "yandexgpt", "embeddings"],
    "authors": [
        {
            "name": "Ivan Maximov",
            "email": "jazz@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "JazzMax\\YandexAi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JazzMax\\YandexAi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JazzMax\\YandexAi\\YandexAiServiceProvider"
            ],
            "aliases": {
                "YandexAi": "JazzMax\\YandexAi\\Facades\\YandexAi"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
